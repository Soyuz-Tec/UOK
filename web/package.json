{
  "name": "uok",
  "private": true,
  "version": "3.1.0-alpha.3",
  "type": "module",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "postinstall": "node scripts/patch-redocly-js-yaml.cjs",
    "generate:client": "openapi-typescript src/generated/openapi.json -o src/generated/openapi.d.ts",
    "generate:api": "python ../scripts/export_openapi_schema.py && npm run generate:client",
    "generate:modules": "python ../scripts/generate_frontend_module_catalog.py",
    "check:contracts": "python ../scripts/check_generated_contracts.py",
    "check:dependencies": "node scripts/check-dependency-policy.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "lint": "node scripts/run-eslint.mjs",
    "lint:styles": "stylelint \"src/**/*.css\" \"../modules/*/web/src/**/*.css\"",
    "test": "vitest run",
    "test:accessibility": "playwright test e2e/accessibility.spec.ts",
    "test:ui-proof": "playwright test",
    "build:client": "tsc -b && vite build --base=/static/app/",
    "build": "npm run generate:api && npm run generate:modules && npm run build:client",
    "build:static": "npm run generate:api && npm run generate:modules && npm run build:client -- --outDir ../src/uok/static/app --emptyOutDir",
    "dev": "vite --host 127.0.0.1 --port 5187"
  },
  "dependencies": {
    "lucide-react": "1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "@redocly/openapi-core": {
      "js-yaml": "5.2.2"
    }
  }
}
